function quizQuestions_() {
  return { pass: QUIZ_PASS, total: QUIZ.length, questions: QUIZ.map(x => ({ id: x.id, ch: x.ch, q: x.q, o: x.o })) };
}

function gradeQuiz_(answers) {
  const results = QUIZ.map(x => {
    const raw = answers ? answers[x.id] : undefined;
    const chosen = raw === undefined || raw === null || raw === '' ? -1 : Number(raw);
    return { id: x.id, ch: x.ch, q: x.q, o: x.o, chosen: chosen, correct: x.a, ok: chosen === x.a, e: x.e };
  });
  const score = results.filter(r => r.ok).length;
  return { score: score, total: QUIZ.length, pass: score >= QUIZ_PASS, results: results };
}

function quizSubmit_(b) {
  const name = String(b.name || '').replace(/[\u0000-\u001f\u007f]/g, '').trim();
  if (!name || name.length > 80) fail_('invalid_name', '이름을 80자 이내로 입력해 주세요.');
  const answers = b.answers && typeof b.answers === 'object' ? b.answers : {};
  const missing = QUIZ.filter(x => { const v = answers[x.id]; return !(Number(v) >= 0 && Number(v) <= 4 && String(v) !== ''); }).map(x => Number(x.id.slice(1)));
  if (missing.length) fail_('incomplete', '아직 답하지 않은 문항이 있습니다: ' + missing.join(', ') + '번');
  const graded = gradeQuiz_(answers);
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    appendRow_('QuizAttempts', { id: 'QZ' + randomToken_().slice(0, 10).toUpperCase(), submittedAt: now_(), name: name, score: graded.score,
      total: graded.total, result: graded.pass ? 'Pass' : 'Fail',
      wrong: graded.results.filter(r => !r.ok).map(r => Number(r.id.slice(1))).join(','),
      answersJson: JSON.stringify(QUIZ.map(x => Number(answers[x.id]))) });
  } finally {
    lock.releaseLock();
  }
  return graded;
}

function adminQuizList_(b) {
  requireAdmin_(b);
  const attempts = rows_('QuizAttempts').map(r => ({ id: r.id, submittedAt: r.submittedAt, name: r.name, score: Number(r.score), total: Number(r.total),
    result: r.result, wrong: String(r.wrong || '').split(',').filter(Boolean).map(Number) }));
  attempts.sort((x, y) => String(y.submittedAt).localeCompare(String(x.submittedAt)));
  return { pass: QUIZ_PASS, attempts: attempts };
}
